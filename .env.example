# ─────────────────────────────────────────────────────────────
# School Exam Analytics System — environment configuration
# Copy this file to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Port the web server listens on
PORT=3000

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# The default below matches `scripts/db-init.js` and local Postgres.
DATABASE_URL=postgres://exam:examsecret@localhost:5432/exam_db

# Secret used to sign the session cookie (change this to a long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Node environment: development | production
NODE_ENV=development

# Caching TTL for /api/init in seconds (5 minutes by default)
INIT_CACHE_TTL=300
